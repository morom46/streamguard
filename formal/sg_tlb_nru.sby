# TLB with the not-recently-used policy: same properties, plus the policy's own.
# Run from the repository root with: make formal

[options]
mode prove
depth 4

[engines]
smtbmc z3

[script]
read_verilog -sv -formal sg_tlb.sv
chparam -set ENTRIES 4 -set POLICY 1 sg_tlb
prep -top sg_tlb
async2sync

[files]
rtl/sg_tlb.sv
